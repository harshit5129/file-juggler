# .NET build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
TestResults/
*.binlog

# Native AOT intermediate output (ILC-generated sources, object files)
*.nativecodewriter.dll
*.obj
generated/

