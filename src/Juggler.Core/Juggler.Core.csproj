<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    This assembly is referenced by the resident daemon, which is published with NativeAOT.
    Setting IsAotCompatible turns on the trim/AOT analyzers so that using a reflection-heavy
    dependency here fails the build rather than the user's runtime. See docs/architecture.md.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A handful of members are internal test seams rather than public API: the wildcard matcher
      and the filename sanitiser. Both are pure functions with no caller outside this assembly,
      and widening them to public purely so a test can reach them would make them API that other
      code is free to depend on.
    -->
    <InternalsVisibleTo Include="Juggler.Core.Tests" />
  </ItemGroup>

</Project>
