<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    This assembly is referenced by the resident daemon, which is published with NativeAOT.
    Setting IsAotCompatible turns on the trim/AOT analyzers so that using a reflection-heavy
    dependency here fails the build rather than the user's runtime. See docs/architecture.md.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
