<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Juggler.Ui.Views"
             x:Class="Juggler.Ui.Views.LogView"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,18,24,18">

        <!-- TOOLBAR -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ComboBox x:Name="SeverityFilter" Width="170" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All messages" />
                    <ComboBoxItem Content="Errors only" />
                    <ComboBoxItem Content="Warnings only" />
                </ComboBox>
                <CheckBox x:Name="FollowCheck" Content="Follow" IsChecked="True" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="Open log folder" Click="OnRevealLogs" />
                <Button Classes="ghost" Content="Refresh" Click="OnRefresh" />
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Border Grid.Row="1" Classes="inset" Padding="0">
            <Panel>

                <ScrollViewer>
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="views:LogEntry">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="14,5">
                                    <TextBlock Grid.Column="0" Classes="mono"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding Time}" Margin="0,0,12,0" />
                                    <Ellipse Grid.Column="1" Width="7" Height="7"
                                             VerticalAlignment="Center" Margin="0,0,12,0"
                                             Fill="{Binding SeverityBrush}" />
                                    <TextBlock Grid.Column="2" Classes="mono wrap" Text="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <StackPanel x:Name="EmptyState" Spacing="10" MaxWidth="400"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="Nothing to show" Classes="title" HorizontalAlignment="Center" />

                    <TextBlock Classes="secondary wrap" TextAlignment="Center"
                               Text="The daemon writes its activity log here. It is not running yet, so there is nothing to display &#8212; configuration problems will still appear above." />

                    <Button Classes="ghost" Content="Open log folder" HorizontalAlignment="Center"
                            Click="OnRevealLogs" />
                </StackPanel>

            </Panel>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="Transparent">
            <TextBlock x:Name="FooterText" Classes="caption" />
        </Border>

    </Grid>
</UserControl>
