<!--
  The initial size below is a starting point only. An explicit size once made Avalonia
  create the platform frame at that many *physical* pixels while laying the content out
  in DIP, so on a scaled display the right-hand edge of every rule row and toolbar was
  clipped off-screen and its buttons could not be clicked. ClampToWorkArea() derives the
  real size from the screen's working area, so there is a single source of truth for it.
  Do not remove Width/Height: without them the window opens at the platform default.
  Do not "fix" clipping by editing the numbers here: fix ClampToWorkArea() instead.
--><Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Juggler.Ui.Views"
        x:Class="Juggler.Ui.Views.MainWindow"
        Title="File Juggler"
        Icon="/Assets/Icon.ico"
        Width="1180" Height="800"
        MinWidth="900" MinHeight="560"
        MaxWidth="1800" MaxHeight="1200"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- UPDATE NOTICE -->
        <!-- Quiet by design: it is a suggestion, not an alarm. Nothing here changes files, and
             there is no download-and-replace - the user decides when to upgrade. -->
        <Border Grid.Row="0" x:Name="UpdateBanner" IsVisible="False"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,9">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="UpdateText" Grid.Column="0"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="ghost" Content="Download" Click="OnOpenReleasePage" />
                    <Button Classes="ghost" Content="Dismiss" Click="OnDismissUpdate" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid ColumnDefinitions="*,Auto" Height="60">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">

                    <!-- The brand mark. This is the one deliberately non-monochrome element on
                         screen: a product is allowed exactly one identity accent. Sized at 28px
                         because the emblem's internal detail stops resolving much below that. -->
                    <Image Source="/Assets/Icon.png"
                           Width="28" Height="28"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />

                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="File Juggler" Classes="title" />
                        <TextBlock x:Name="SubtitleText" Classes="caption" Text="Rule editor" />
                    </StackPanel>
                </StackPanel>

                <!-- Trailing Auto column, so this cluster is sized from its own content and
                     lands hard against the right edge. The alternative, a leading "Auto,*,Auto"
                     with a star spacer, put this cluster off-screen: the spacer absorbed the
                     whole width and the buttons were clipped. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Ambient state. A dot and a word, no pill: the state is already the
                         least important thing in this window. -->
                    <StackPanel x:Name="StateChip"
                                Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                IsVisible="False">
                        <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" />
                        <TextBlock x:Name="StateChipText" Classes="caption"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="Running" />
                    </StackPanel>

                    <Button x:Name="ThemeButton" Classes="icon"
                            ToolTip.Tip="Switch between light and dark"
                            Click="OnToggleTheme">
                        <TextBlock x:Name="ThemeGlyph" Text="&#9680;" FontSize="14" />
                    </Button>

                    <Button Classes="ghost" Content="Diagnostics"
                            ToolTip.Tip="Print diagnostic state"
                            Click="OnDoctor" />

                    <Button Classes="accent" Content="New rule" Click="OnNewRule" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <TabControl Grid.Row="2" x:Name="Tabs">

            <TabItem Header="Rules">
                <views:RulesView x:Name="Rules" />
            </TabItem>

            <TabItem Header="Log">
                <views:LogView x:Name="Log" />
            </TabItem>

            <TabItem Header="Settings">
                <views:SettingsView x:Name="Settings" />
            </TabItem>

        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="32">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock x:Name="StatusRules" Classes="status" Text="0 of 0 rules enabled" />
                </StackPanel>

                <!-- Only visible while a guard is engaged, so it is never noise. -->
                <Border x:Name="DryRunChip" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="{DynamicResource RadiusPill}"
                        Background="{DynamicResource WarningSoftBrush}"
                        Padding="10,3" IsVisible="False">
                    <TextBlock Text="Dry run &#8212; no changes will be made"
                               FontSize="{DynamicResource FontSizeMicro}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusStats" Classes="status" Text="0 files processed" />
                    <TextBlock x:Name="StatusBytes" Classes="status" Text="0 B" />
                    <TextBlock x:Name="StatusPath" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
