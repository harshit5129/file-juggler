<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the emblem as a Win32 icon resource. Avalonia's Window.Icon only sets the
         runtime window icon; without this the .exe has no file icon, so Explorer, the taskbar
         and any installer-created shortcut would show the default blank application icon. -->
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Brand assets. Icon.ico carries the multi-resolution set Windows needs for the title bar,
         taskbar and tray; Icon.png is the same emblem for in-app rendering at arbitrary sizes.
         Without the explicit AvaloniaResource entries these resolve as file paths and the icon
         silently fails to load at runtime. -->
    <AvaloniaResource Include="Assets\Icon.ico" />
    <AvaloniaResource Include="Assets\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juggler.Core\Juggler.Core.csproj" />
  </ItemGroup>

</Project>
