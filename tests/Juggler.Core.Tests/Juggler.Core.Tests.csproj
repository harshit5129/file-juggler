<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Juggler.Core\Juggler.Core.csproj" />

    <!-- UpdateCheck lives in the UI project, and the version comparison it does is the kind of
         off-by-a-digit bug that is cheap to test and expensive to ship: a string compare puts
         0.10.0 behind 0.9.0 and would strand every user on an old build. Referencing the UI
         project pulls in Avalonia, which costs nothing here because none of these tests construct
         a window. -->
    <ProjectReference Include="..\..\src\Juggler.Ui\Juggler.Ui.csproj" />
  </ItemGroup>

</Project>